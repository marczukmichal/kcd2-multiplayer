@inherits ModalBase
@using KCDMP_launcher.Models
@using System.Windows.Forms
@using System.Threading

@if (IsVisible)
{
    <div class="modal-overlay @(isClosing ? "closing" : "" )">
        <div class="modal-box" @onclick:stopPropagation="true">

            <div class="modal-frame-top modal-frame-bg"></div>

            <div class="modal-content" style="text-align: left;">
                <div class="modal-title" style="text-align: center;">LAUNCHER SETTINGS</div>

                <div class="kcd-input-group">
                    <label class="kcd-label">Game Executable Path</label>

                    <div style="display: flex; gap: 10px;">
                        <input class="kcd-input" @bind="Settings.GamePath" style="flex-grow: 1;" />

                        <button class="kcd-btn" @onclick="BrowseGamePath" style="padding: 8px 15px; font-size: 12px;">
                            BROWSE
                        </button>
                    </div>
                </div>

                <div class="kcd-input-group">
                    <label class="kcd-label">Multiplayer DLL Path</label>
                    <input class="kcd-input" @bind="Settings.DllPath" />
                </div>

                <div class="kcd-input-group">
                    <label class="kcd-label">Master Server URL</label>
                    <input class="kcd-input" @bind="Settings.MasterServerUrl" />
                </div>

                <div class="modal-actions">
                    <button class="kcd-btn primary" @onclick="OnSave">SAVE & CLOSE</button>
                    <button class="kcd-btn" @onclick="CloseModalAsync">CANCEL</button>
                </div>
            </div>

            <div class="modal-frame-bottom modal-frame-bg"></div>
        </div>
    </div>
}

@code {
    [Parameter] public AppSettings Settings { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }

    private void BrowseGamePath()
    {
        var thread = new Thread(() =>
        {
            var dialog = new OpenFileDialog();
            dialog.Filter = "KingdomCome.exe|KingdomCome.exe|Executables (*.exe)|*.exe|All Files (*.*)|*.*";
            dialog.Title = "Select Kingdom Come: Deliverance Executable";

            if (dialog.ShowDialog() == DialogResult.OK)
            {
                Settings.GamePath = dialog.FileName;

                InvokeAsync(StateHasChanged);
            }
        });

        thread.SetApartmentState(ApartmentState.STA);
        thread.Start();
        thread.Join();
    }
}